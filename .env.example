# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Phases 1-4: use the service_role key (never commit it, never ship it in a client)
# Phase 5+: switch to the anon key and enable RLS
SUPABASE_KEY=<your-service-role-key>

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# Confirm current model IDs from https://ai.google.dev/gemini-api/docs/models/gemini
# before starting Phase 2. Do not paste values from memory — they change.
CHAT_MODEL=gemini-2.5-flash
EMBED_MODEL=models/text-embedding-004

# Optional — defaults shown
# EMBED_DIM=768
# TOP_K=5
# RECALL_USER_ID=00000000-0000-0000-0000-000000000001
